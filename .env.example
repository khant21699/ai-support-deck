# Copy this file to `.env` in the project root. `docker compose` reads it automatically.
# Anything you leave out uses the defaults shown here (Ollama running on your computer).
# More options and examples (OpenAI, Groq, Claude, ...): backend/.env.example

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=

EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BASE_URL=
EMBED_API_KEY=

SECRET_KEY=dev-secret-change-me

# INFO logs every request and AI call. DEBUG also logs prompts and answers (contains customer text).
LOG_LEVEL=INFO
