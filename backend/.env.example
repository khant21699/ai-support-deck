DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/support
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# DEBUG | INFO | WARNING | ERROR. DEBUG also logs prompts and model answers (contains customer text).
LOG_LEVEL=INFO

# ---- Chat model (classifies tickets, writes draft replies) ----
# LLM_PROVIDER is one of: ollama | openai_compatible | anthropic
# LLM_BASE_URL can stay empty: each provider has a normal address.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=

# ---- Embedding model (knowledge base search) ----
# EMBED_PROVIDER is one of: ollama | openai_compatible   (Anthropic has no embeddings)
# EMBED_DIM must match the model. After changing the embedding model, run: make reindex
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BASE_URL=
EMBED_API_KEY=

OLLAMA_URL=http://localhost:11434
KB_MIN_SCORE=0.35

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ---- Examples: copy the lines you need ----
# OpenAI    LLM_PROVIDER=openai_compatible  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
#           EMBED_PROVIDER=openai_compatible  EMBED_MODEL=text-embedding-3-small  EMBED_DIM=1536  EMBED_API_KEY=sk-...
# Groq      LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant  LLM_API_KEY=gsk_...
# OpenRouter  LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.1-8b-instruct  LLM_API_KEY=sk-or-...
# LM Studio LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:1234/v1  LLM_MODEL=<the model you loaded>
# Claude    LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5-5  LLM_API_KEY=sk-ant-...   (keep EMBED_PROVIDER=ollama)
